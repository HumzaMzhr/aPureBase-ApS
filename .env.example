OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Optional display name; update when changing voice identity.
ELEVENLABS_VOICE_NAME=Isabella
# Optional overrides, omitted to use ElevenLabs stored/default settings.
# ELEVENLABS_VOICE_SETTINGS={"stability":0.5,"similarity_boost":0.75}
ELEVENLABS_TIMEOUT_MS=30000
# Optional A/B settings. Restart the server after changes.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_TRANSLATION_REASONING=none
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=marin
OPENAI_CLINIC_VOICE=cedar

# Recognition runs during speech; only a finalized complete turn is translated.
OPENAI_TRANSCRIPTION_MODE=realtime
OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_TRANSCRIBE_DELAY=low
OPENAI_CAREFUL_TRANSLATION_MODEL=gpt-5.5
AGENT_SILENCE_MS=450
CLINIC_SILENCE_MS=1350

# Stage 1.7 experimental streaming only; controlled routing remains above.
STREAMING_TRANSLATION_MODEL=gpt-6-luna
STREAMING_SERVICE_TIER=default
# Provider character buffering, four values 50–500; partial clauses use auto_mode=false.
STREAMING_TTS_SCHEDULE=50,50,50,50
